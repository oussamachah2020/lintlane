{
  "name": "lintlane",
  "version": "4.1.0",
  "description": "Code-quality workflow for JavaScript, React and Next.js: orchestrates Biome, lint-staged, Husky, Commitizen and commitlint, with a local dashboard and CI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lintlane": "bin/cli.mjs",
    "lintlane-mcp": "bin/mcp.mjs"
  },
  "exports": {
    "./biome": "./presets/base.json",
    "./biome/strict": "./presets/strict.json",
    "./biome/next": "./presets/next.json",
    "./package.json": "./package.json",
    "./commitlint": "./presets/commitlint.mjs",
    "./commitizen": "./presets/commitizen.cjs"
  },
  "files": [
    "bin",
    "presets",
    "ui",
    "templates",
    "README.md",
    "skills"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "LINTLANE_E2E=1 node --test \"test/e2e.test.mjs\""
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.2.0 <3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "lintlane",
    "biome",
    "react",
    "lint",
    "format",
    "lint-staged",
    "husky",
    "commitlint",
    "commitizen"
  ],
  "author": "Expo2Dev",
  "dependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "lint-staged": "16.4.0",
    "zod": "4.6.7"
  }
}
